# TastyFind Backend Environment Configuration
PORT=4000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tastyfind_db

# Local Fallback Configuration (Automatically uses high-fidelity in-memory storage if MySQL is unavailable)
USE_LOCAL_FALLBACK=true

# Ranking Algorithm Config
BAYESIAN_MIN_REVIEWS=10
